<!-- BEGIN main_block -->
<div class="wbce-section-shell wbce-addons-shell">
<header class="wbce-section-hero"><i class="fa fa-cubes"></i><div><h2>{ADDONS_OVERVIEW}</h2><p>{ADDONS_INTRO}</p></div>{URL_ADVANCED}</header>
<!-- BEGIN upload_block --><section class="wbce-section-card wbce-addon-upload-card"><h3><i class="fa fa-upload" aria-hidden="true"></i> {UPLOAD_HEADING}</h3><p>{UPLOAD_INTRO}</p><form enctype="multipart/form-data" action="{ADMIN_URL}/modules/install.php" method="post" data-wbce-chunk-upload data-unified-addon="1" data-chunk-token="{CHUNK_UPLOAD_TOKEN}" data-chunk-url="{ADMIN_URL}/addons/chunk_upload.php" data-max-size="536870912" data-zip-required="{UPLOAD_ZIP_REQUIRED}" data-too-large="{UPLOAD_TOO_LARGE}" data-upload-running="{UPLOAD_RUNNING}" data-upload-failed="{UPLOAD_FAILED}" data-invalid-response="{UPLOAD_INVALID_RESPONSE}">{FTAN}<input type="hidden" name="chunk_upload_id" value=""><label><span>{UPLOAD_FILE}</span><input type="file" name="userfile" accept=".zip,application/zip" required></label><label><input type="checkbox" name="overwrite" value="false"> {UPLOAD_OVERWRITE}</label><button type="submit" name="submit"><i class="fa fa-check" aria-hidden="true"></i> {UPLOAD_INSTALL}</button></form></section><!-- END upload_block -->
<div class="wbce-section-grid wbce-addons-overview-grid">
<!-- BEGIN modules_block --><a class="wbce-section-card" href="{ADMIN_URL}/modules/index.php" {DISPLAY_MODULES}><span class="wbce-section-icon"><i class="fa fa-puzzle-piece"></i></span><span><h3>{MODULES}</h3><p>{MODULES_OVERVIEW}</p></span></a><!-- END modules_block -->
<!-- BEGIN templates_block --><a class="wbce-section-card" href="{ADMIN_URL}/templates/index.php" {DISPLAY_TEMPLATES}><span class="wbce-section-icon"><i class="fa fa-map"></i></span><span><h3>{TEMPLATES}</h3><p>{TEMPLATES_OVERVIEW}</p></span></a><!-- END templates_block -->
<!-- BEGIN languages_block --><a class="wbce-section-card" href="{ADMIN_URL}/languages/index.php" {DISPLAY_LANGUAGES}><span class="wbce-section-icon"><i class="fa fa-language"></i></span><span><h3>{LANGUAGES}</h3><p>{LANGUAGES_OVERVIEW}</p></span></a><!-- END languages_block -->
</div>
<!-- BEGIN reload_block --><section class="wbce-section-card wbce-section-card--advanced" {DISPLAY_RELOAD}><h3><i class="fa fa-refresh"></i> {TXT_ADMIN_SETTINGS}</h3><form action="{RELOAD_URL}" method="post">{FTAN}<p>{MESSAGE_RELOAD_ADDONS}</p><label {DISPLAY_MODULES}><input type="checkbox" name="reload_modules" value="true"> {MODULES}</label><label {DISPLAY_TEMPLATES}><input type="checkbox" name="reload_templates" value="true"> {TEMPLATES}</label><label {DISPLAY_LANGUAGES}><input type="checkbox" name="reload_languages" value="true"> {LANGUAGES}</label><button type="submit" name="submit"><i class="fa fa-refresh"></i> {TEXT_RELOAD}</button></form></section><!-- END reload_block -->
</div>
<!-- END main_block -->
<script src="{ADMIN_URL}/addons/chunk-upload.js?v=1.7.0"></script>
