<!-- BEGIN main_block -->
<!DOCTYPE html>
<html>
    <head>
        <title>Set upload parameter</title>

        <!-- Theme meta data -->
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <!-- Website meta data -->
        <meta name="description" content="Set upload parameter" />
        <meta name="keywords" content="Set upload parameter" />
        <meta name="author" content="Jonathan Nessier" />

        <!-- Theme favicons -->
        <link rel="icon" href="../../templates/wbce-cms/images/favicons/favicon.ico" sizes="any" />
        <link rel="icon" type="image/png" sizes="32x32" href="../../templates/wbce-cms/images/favicons/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="../../templates/wbce-cms/images/favicons/favicon-16x16.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="../../templates/wbce-cms/images/favicons/apple-touch-icon.png" />
        <meta name="theme-color" content="#2563eb" />

        <!-- Theme CSS -->
        <link href="../../templates/wbce-cms/css/style.min.css?v1.0.6" rel="stylesheet" type="text/css" />
        <link href="../../templates/wbce-cms/css/media-cms.css?v1.0.29" rel="stylesheet" type="text/css" />

        <!-- Initiliaze vars -->
        <script>
            var WB_URL = '../..',
                THEME_URL = '../../templates/wbce-cms',
                ADMIN_URL = '{ADMIN_URL}',
                LANGUAGE_CODE = navigator.language || navigator.userLanguage,
                THEME_VERSION = '1.0.6';
        </script>

        <!-- Theme jQuery -->
        <script src="../../templates/wbce-cms/js/jquery.min.js?v1.0.6"></script>

        <!-- WBCE helper JavaScript -->
        <script>
            function confirm_link(message, url) {
                if (confirm(message))
                    location.href = url;
            }
        </script>

        <!-- Theme JavaScript -->
        <script src="../../templates/wbce-cms/js/script.min.js?v1.0.6"></script>
        <script src="../../templates/wbce-cms/js/media-cms.js?v1.0.8" defer></script>

    </head>
    <body id="setParameterPage">

        <div class="container-fluid">

            <h4>{TEXT_HEADER}</h4>

            <form method="post" action="{ADMIN_URL}/media/setparameter.php" class="{DISPLAY_LIST_TABLE} form-horizontal">
                <input type="hidden" name="dir" value="{DIR}" />
                <input type="hidden" name="old_name" value="{FILENAME}" />
                <input type="hidden" name="id" value="{FILE_ID}" />
                {FTAN}

                <div class="form-group {DISPLAY_ADMIN}">
                    <label class="col-sm-2 col-form-label">{SETTINGS}</label>
                    <div class="col-sm-10">
                        <div class="checkbox">
                            <label>
                                <input type="checkbox" name="show_thumbs" {NO_SHOW_THUMBS_SELECTED}> {NO_SHOW_THUMBS}
                            </label>
                        </div>
                        <div class="checkbox">
                            <label>
                                <input type="checkbox" name="admin_only" {ADMIN_ONLY_SELECTED}> {ADMIN_ONLY}
                            </label>
                        </div>
                    </div>
                </div>
                <hr />
                <!-- BEGIN list_block -->
                <div class="form-group row">
                    <label class="col-sm-4 col-form-label">{PATH_NAME}</label>
                    <label class="col-sm-2 col-form-label">{WIDTH}</label>
                    <div class="col-sm-2">
                        <div class="input-group">
                            <input size="5" type="text" class="form-control" name="{FIELD_NAME_W}" value="{CUR_WIDTH}">
                            <div class="input-group-append">
                                <span class="input-group-text">
                                    px
                                </span>
                            </div>
                        </div>
                    </div>
                    <label class="col-sm-2 col-form-label">{HEIGHT}</label>
                    <div class="col-sm-2">
                        <div class="input-group">
                            <input size="5" type="text" class="form-control" name="{FIELD_NAME_H}" value="{CUR_HEIGHT}">
                            <div class="input-group-append">
                                <span class="input-group-text">
                                    px
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- END list_block -->
                <div class="form-group">
                    <button class="btn btn-primary" type="submit" name="save"><i class="fa fa-fw fa-floppy-o"></i> {SAVE_TEXT}</button>
                    <a href="browse.php" class="btn btn-outline-light">
                        <i class="fa fa-fw fa-arrow-circle-left"></i> {BACK}
                    </a>
                </div>
            </form>

        </div>

    </body>
</html>
<!-- END main_block -->
