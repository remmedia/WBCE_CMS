<!-- BEGIN main_block -->

<div class="wbce-users-shell"><header class="wbce-users-hero"><i class="fa fa-user-circle"></i><div><h2>{HEADING_USERS}</h2><p>Konten übersichtlich auswählen, bearbeiten oder deaktivieren.</p></div><!-- BEGIN manage_groups_block --><a class="wbce-users-link" href="{ADMIN_URL}/groups/index.php"><i class="fa fa-users"></i> {TEXT_MANAGE_GROUPS}</a><!-- END manage_groups_block --></header><form name="users" action="users.php" method="post" class="wbce-user-card">{FTAN}<input type="hidden" name="userstatus" value="{USER_STATUS}"><h3 class="wbce-user-card__title"><i class="fa fa-address-book"></i> {HEADING_MODIFY_DELETE_USER}</h3><div class="wbce-users-toolbar"><div class="wbce-users-select"><label for="wbce-user-list">{USERTYPE}</label><select id="wbce-user-list" name="user_id"><!-- BEGIN list_block --><option value="{VALUE}" {STATUS}>{NAME}</option><!-- END list_block --></select></div><div class="wbce-users-buttons"><button type="submit" name="modify" value="{TEXT_MODIFY}" class="{DISPLAY_MODIFY}"><i class="fa fa-fw fa-pencil"></i> {TEXT_MODIFY}</button><button type="submit" name="delete" value="{TEXT_DELETE}" onclick="return confirm('{CONFIRM_DELETE}');" class="{DISPLAY_DELETE} danger"><i class="fa fa-fw fa-remove"></i> {TEXT_DELETE}</button></div></div><a class="wbce-users-toggle" href="index.php?status={USER_STATUS}"><i class="fa fa-exchange"></i> {TEXT_USERS}</a></form></div>
<!-- END main_block -->
