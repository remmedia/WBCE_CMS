<!-- BEGIN header_block -->
<!DOCTYPE html>
<html lang="{LANGUAGE}">
    <head>
        <title>{TEXT_LOGIN}</title>

        <!-- Theme meta data -->
        <meta charset="{CHARSET}">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <!-- Website meta data -->
        <meta name="description" content="{TEXT_ADMINISTRATION}" />
        <meta name="keywords" content="{TEXT_ADMINISTRATION}" />
        <meta name="author" content="Jonathan Nessier" />

        <!-- Theme favicons -->
        <link rel="icon" href="{THEME_URL}/images/favicons/favicon.ico" sizes="any" />
        <link rel="icon" type="image/svg+xml" href="{THEME_URL}/images/favicons/favicon.svg" />
        <link rel="icon" type="image/png" sizes="32x32" href="{THEME_URL}/images/favicons/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="{THEME_URL}/images/favicons/favicon-16x16.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="{THEME_URL}/images/favicons/apple-touch-icon.png" />
        <link rel="mask-icon" href="{THEME_URL}/images/favicons/safari-pinned-tab.svg" color="#1d4ed8" />
        <link rel="manifest" href="{THEME_URL}/images/favicons/site.webmanifest" />
        <meta name="theme-color" content="#2563eb" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-title" content="WBCE CMS" />

        <!-- Theme CSS -->
        <link href="{THEME_URL}/css/style.min.css?v1.0.6" rel="stylesheet" type="text/css" />

        <!-- WBCE module CSS -->
        {BACKEND_MODULE_CSS}
        <link href="{THEME_URL}/css/media-cms.css?v1.0.29" rel="stylesheet" type="text/css" />

        <!-- Initiliaze vars -->
        <script>
            var WB_URL = '{WB_URL}',
                THEME_URL = '{THEME_URL}',
                ADMIN_URL = '{ADMIN_URL}',
                LANGUAGE_CODE = '{LANGUAGE}',
                THEME_VERSION = '1.0.6';
        </script>

        <!-- Theme jQuery -->
        <script src="{THEME_URL}/js/jquery.min.js?v1.0.6"></script>

        <!-- WBCE helper JavaScript -->
        <script>
            function confirm_link(message, url) {
                if (confirm(message))
                    location.href = url;
            }
        </script>

        <!-- Theme JavaScript -->
        <script src="{THEME_URL}/js/script.min.js?v1.0.6"></script>
        <script src="{THEME_URL}/js/media-cms.js?v1.0.8" defer></script>

        {BACKEND_MODULE_JS}

    </head>
    <body class="fixed-nav prepage">

        <div id="main-content">
            <div class="container-fluid">

                <div id="prepage">

                    <div class="row">
                        <div class="col-md-6 mx-md-auto col-lg-4">
                            <header id="prepageHeader">
                                <span class="brand">
                                    <span class="media-cms-wordmark media-cms-wordmark-login" aria-label="WBCE CMS"><strong>WBCE</strong><span>CMS</span></span>
                                </span>
                            </header>
                        </div>
                    </div>

                    <div id="loginPage">

                        <div class="row">
                            <div class="col-md-6 mx-md-auto col-lg-4">

                                <div class="card">
                                    <h4 class="card-header media-cms-login-heading">{TEXT_LOGIN}</h4>
                                    <div class="card-body">

                                        <div class="media-cms-login-message media-cms-login-attempts-{ATTEMPTS}">{MESSAGE}</div>

                                        <form name="login" class="media-cms-login-form" action="{ACTION_URL}" method="post" autocomplete="off">
                                            <input type="hidden" name="url" value="{URL}" />
                                            <input type="hidden" name="username_fieldname" value="{USERNAME_FIELDNAME}" />
                                            <input type="hidden" name="password_fieldname" value="{PASSWORD_FIELDNAME}" autocomplete="off" />

                                            <div class="form-group media-cms-login-field">
                                                <label for="inputUsername">{TEXT_USERNAME}</label>
                                                <span class="media-cms-login-input"><i class="fa fa-user" aria-hidden="true"></i><input class="form-control" type="text" maxlength="{MAX_USERNAME_LEN}" name="{USERNAME_FIELDNAME}" value="{USERNAME}" id="inputUsername" autocomplete="username" /></span>
                                            </div>

                                            <div class="form-group media-cms-login-field">
                                                <label for="inputPassword">{TEXT_PASSWORD}</label>
                                                <span class="media-cms-login-input"><i class="fa fa-lock" aria-hidden="true"></i><input class="form-control" type="password" autocomplete="current-password" maxlength="{MAX_PASSWORD_LEN}" name="{PASSWORD_FIELDNAME}" id="inputPassword" /></span>
                                            </div>
											
											<div class="form-group media-cms-login-captcha">
                                                {CAPTCHA}
                                            </div>

                                            <button type="submit" class="btn btn-primary media-cms-login-submit"><i class="fa fa-sign-in" aria-hidden="true"></i><span>{TEXT_LOGIN}</span></button>
                                        </form>

                                        <ul class="list-unstyled media-cms-login-links">
                                            <li><a href="{FORGOTTEN_DETAILS_APP}">{TEXT_FORGOTTEN_DETAILS}</a></li>

                                        </ul>

                                    </div>
                                    <div class="card-footer text-right">
                                        <a class="media-cms-login-home" href="{WB_URL}">
                                            <i class="fa fa-fw fa-desktop"></i> {TEXT_HOME}
                                        </a>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>

                    <div class="row">
                    </div>

                </div>
            </div>
        </div>
    </body>
</html>
<!-- END main_block -->
