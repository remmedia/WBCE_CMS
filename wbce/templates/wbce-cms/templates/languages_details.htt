    <div class="fg9">{CODE}</div>
    <hr class="fg12 nom">
    <div class="fg3 bold">{TEXT_AUTHOR}:</div>
    <div class="fg9">{AUTHOR}</div>
    <hr class="fg12 nom">
    <div class="fg3 bold">{TEXT_VERSION}:</div>
    <div class="fg9">{VERSION}</div>
</div>

