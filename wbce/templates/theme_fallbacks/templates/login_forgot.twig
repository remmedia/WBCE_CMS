{#
    login_forgot.twig — Password recovery form
    Extends login_wrapper.twig for the outer HTML chrome.

    Variables: WB_URL, THEME_URL, ACTION_URL, EMAIL, FTAN, CAPTCHA,
              SHOW_FORM, MESSAGE, LOGIN_URL, CHARSET, LANGUAGE
#}
{% extends 'login_wrapper.twig' %}

{% block title %}{{ L_('MENU:FORGOT') }}{% endblock %}

{% block page_heading %}{{ L_('MENU:FORGOT') }}{% endblock %}

{% block login_content %}
    {% if MESSAGE and FORM_SUBMITTED|default(false) %}
    <div class="media-cms-login-message">
        {{ MESSAGE|raw }}
    </div>
    {% endif %}

    {% if SHOW_FORM %}
    <form class="media-cms-login-form media-cms-forgot-form" name="forgot" action="{{ ACTION_URL }}" method="post" autocomplete="off">
        {{ FTAN }}
        <div class="media-cms-login-field">
            <label for="inputEmail">{{ L_('TEXT:EMAIL') }}</label>
            <span class="media-cms-login-input"><svg class="media-cms-login-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5.5h18v13H3zM4.5 7l7.5 5.5L19.5 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><input class="form-control" id="inputEmail" type="email" name="email" maxlength="255" value="{{ EMAIL }}" autocomplete="email" required></span>
        </div>
        {% if CAPTCHA %}<div class="media-cms-login-captcha">{{ CAPTCHA|raw }}</div>{% endif %}
        <button type="submit" class="btn btn-primary media-cms-login-submit">{{ L_('TEXT:SEND_DETAILS') }}</button>
    </form>
    {% endif %}

    <div class="links center media-cms-login-links">
        <p><a href="{{ LOGIN_URL }}">{{ L_('TEXT:NEED_TO_LOGIN') }}</a></p>
    </div>
{% endblock %}
